{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".build-src",
    "outDir": "dist/types",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    ".build-src/**/*.ts",
    ".build-src/**/*.tsx"
  ]
}
